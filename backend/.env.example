# Copy to backend/.env and fill in. Never commit real values.
CONVEAZY_ENV=development
CONVEAZY_DATABASE_URL=postgresql+psycopg://conveazy:conveazy@localhost:5432/conveazy
# 32+ random chars: python -c "import secrets; print(secrets.token_urlsafe(48))"
CONVEAZY_JWT_SECRET=
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONVEAZY_DATA_ENCRYPTION_KEY=
CONVEAZY_COOKIE_SECURE=false

# AI: mock | openai | gemini. Without a key the app falls back to clearly labelled mock mode.
CONVEAZY_AI_PROVIDER=mock
CONVEAZY_OPENAI_API_KEY=
CONVEAZY_OPENAI_MODEL=gpt-4o-mini
CONVEAZY_GEMINI_API_KEY=
CONVEAZY_GEMINI_MODEL=gemini-1.5-flash

CONVEAZY_AI_RATE_LIMIT_PER_MINUTE=12
CONVEAZY_AUTH_RATE_LIMIT_PER_MINUTE=10
CONVEAZY_DEFAULT_RETENTION_DAYS=365
